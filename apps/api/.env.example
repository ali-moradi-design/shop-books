PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54320/bookstore?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
NODE_ENV=development
# Explicit frontend origin (required for cookie auth). Do not use * in production
# when credentials are enabled — browsers reject Access-Control-Allow-Origin: *.
# Comma-separated list is allowed. If set to *, the API reflects the request
# origin in development/test only.
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
# Cookie flags for accessToken / refreshToken (httpOnly always).
# COOKIE_SECURE defaults to true in production and false in development/test.
COOKIE_SECURE=false
# lax | strict | none  (none requires COOKIE_SECURE=true and HTTPS)
COOKIE_SAME_SITE=lax
# Seed and demo reset clear the storefront's cached catalog through this hook.
# Development defaults: http://localhost:3000/hooks/revalidate and a fixed secret.
# WEB_REVALIDATE_URL=http://localhost:3000/hooks/revalidate
# REVALIDATE_SECRET=change-me
# Optional; omit unless the API is served on a parent domain of the frontend.
# COOKIE_DOMAIN=

# Payments: Stripe Checkout in test mode. Leave STRIPE_SECRET_KEY empty to use the
# built-in simulator (a checkout page in the storefront plus signed webhooks to this API).
STOREFRONT_URL=http://localhost:3000
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYMENT_CURRENCY=usd

# Email: any SMTP server. Without it, emails are kept in the outbox (Admin → Emails).
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Bay Book Company <shop@example.com>
# ADMIN_ALERT_EMAIL=ops@example.com

# Error tracking (optional)
# SENTRY_DSN=https://key@o0.ingest.sentry.io/0

# Proxies in front of the API (1: the storefront forwards the visitor's address on sign-in)
TRUST_PROXY=1
# RATE_LIMIT_MAX=3000
