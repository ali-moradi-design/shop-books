# Server-side fetch base (preferred for RSC / generateStaticParams)
API_URL=http://localhost:4000

# Client-visible base (browser bundles; keep in sync with API_URL for demos)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Secret for POST /hooks/revalidate (the API's seed and demo reset clear the catalog cache).
# Development falls back to a fixed secret; production needs it.
# REVALIDATE_SECRET=change-me

# Optional: error tracking (server and browser) and cookie-free visit statistics
# SENTRY_DSN=https://key@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://key@o0.ingest.sentry.io/0
# NEXT_PUBLIC_ANALYTICS_DOMAIN=shop.example.com
